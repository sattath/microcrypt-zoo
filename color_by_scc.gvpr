/******************************************************************
 apply unique color to all nodes in a strongly-connected set

- two files
  - 1st - the output of sccmap
  - 2nd - the original file

********************************************************************/
BEGIN{
  graph_t Root;
  int     sccmapFinished, DEL[],colorindex;
  string  ColorsArray[];
  string  Color[], currColor, help;

  help="future";
  colorindex=0;
ColorsArray[0]= "white"; // unused: colorindex is incremented before use
ColorsArray[1]= "lightgreen";
ColorsArray[2]= "lightgrey";
ColorsArray[3]= "lightpink";
ColorsArray[4]= "lightblue";
ColorsArray[5]= "khaki";
ColorsArray[6]= "plum";
ColorsArray[7]= "lightcyan";
ColorsArray[8]= "lightsalmon";
ColorsArray[9]= "aquamarine";
  ////////////////////////////////////////////////////////////////////////////
  string X2color(string KEY) {
    string ret;
    int    r1, r2, r3;
    float  H, S, V, dH=1./19.;

    if(Color[KEY]!="") {
      ret=Color[KEY];
      print("//  old color: ",ret);
    } else {
      
      H+=rand()+dH;
      if(H>1.)H-=1.;
      S=.477+(rand()/2.);
      V=1.-(rand()/2.5);
      ret=sprintf("%.3f %.3f %.3f", H, S, V);
      
      
      colorindex+=1;
      ret=ColorsArray[colorindex];
      //ret=ColorsArray[1];
      print("// new color: ",ret);
      Color[KEY]=ret;
      

    }
    print("//  returning color: ", ret);
    return(ret);
  }
  //////////////////////////////////////////////////////////////////////////
  srand();  // used by edge colorizing rtn
}
///// end of BEGIN //////////////////////////////////////////////////////
BEG_G{
  print("////  start: ",$.name);
  Root=$G;
  if (sccmapFinished==0)
    currColor=X2color($.name)
  }
N{
  print("//  node ",$.name, " ", Root.name);
  if (sccmapFinished==0) {
    print("//   currcolor:  ", currColor);
    Color[$.name]=currColor;
  } else {
    if(Color[$.name]!="") {
      if (hasAttr($, "style") && $.style!="")
        $.style=$.style + ", filled";
      else
        $.style="filled";
      $.fillcolor=Color[$.name];
    }
  }
}
// Draw an equivalence A->B, B->A as one double-headed edge when both directions have the same reference,
// or when the reverse direction is trivial (then the edge keeps the non-trivial reference).
// Both edges stay in the graph (so the layout and SCCs are unchanged), the second one is just hidden.
E[sccmapFinished==1 && $.dir!="back" && $.style!="invis"]{
  edge_t r;
  for (r = fstout($.head); r; r = nxtout(r)) {
    if (r.head == $.tail && r.dir!="back" && (r.label==$.label || r.label=="")) {
      $.dir="both";
      r.style="invis";
      r.label="";
      break;
    }
  }
}
END_G{
  if (sccmapFinished==1)
    write($G);
  if ($G.name=="scc_map")
    sccmapFinished=1;
}